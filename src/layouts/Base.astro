---
import iosevka400 from '../assets/fonts/iosevka-400.woff2?url';
import iosevka700 from '../assets/fonts/iosevka-700.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n';
import { hreflang, site } from '../site';
import type { Locale } from '../site';

type SectionId = 'ahora' | 'servicio' | 'trayectoria' | 'skills';

interface Props {
  lang: Locale;
  /** Idioma alternativo disponible; cuando llega, el header muestra el selector. */
  altLang?: Locale;
  /** Secciones presentes en la página, para la navegación. */
  sections?: SectionId[];
}

const { lang, altLang, sections } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/** Versiones de esta página por idioma; el español es la opción por defecto. */
const alternates = [lang, ...(altLang ? [altLang] : [])].map((code) => ({
  hreflang: hreflang[code],
  href: new URL(`/${code}/`, Astro.site).href,
}));
const xDefault = new URL('/es/', Astro.site).href;
/** Imagen para compartir en redes, una por idioma (scripts/og-images.mjs). */
const ogImage = new URL(`/og/${lang}.png`, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={iosevka400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={iosevka700} as="font" type="font/woff2" crossorigin />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0a14" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.author} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} altLang={altLang} sections={sections} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
