---
import { useTranslations } from '../i18n';
import type { Locale } from '../site';

type SectionId = 'ahora' | 'servicio' | 'trayectoria' | 'skills';

interface Props {
  lang: Locale;
  altLang?: Locale;
  /** Solo las secciones presentes en la página: evita anclas muertas. */
  sections?: SectionId[];
}

const { lang, altLang, sections = [] } = Astro.props;
const t = useTranslations(lang);

const links = sections.map((id) => ({ href: `#${id}`, label: t.nav[id] }));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={`/${lang}/`}>{t.nav.brand}</a>
    <nav aria-label={t.nav.sectionsLabel}>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        {altLang && (
          <li>
            <a class="lang" href={`/${altLang}/`} lang={altLang} hreflang={altLang}>
              {altLang.toUpperCase()}
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--divider);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .brand {
    color: var(--lavender);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    text-decoration: underline;
  }

  .lang {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding-inline: 0.625rem;
    min-height: 32px;
    color: var(--stardust);
  }
</style>
