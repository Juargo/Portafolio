---
interface Etapa {
  cargo: string;
  periodo: string;
  descripcion: string;
  capas: string[];
}

interface Props {
  etapas: Etapa[];
}

const { etapas } = Astro.props;
---

<ol class="timeline">
  {etapas.map((etapa) => (
    <li>
      <p class="periodo">{etapa.periodo}</p>
      <h3>{etapa.cargo}</h3>
      <p class="muted">{etapa.descripcion}</p>
      {etapa.capas.length > 0 && (
        <ul class="capas">
          {etapa.capas.map((capa) => <li>#{capa}</li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .timeline {
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
    border-left: 2px solid var(--border);
    margin-left: 0.375rem;
  }

  .timeline > li {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  /* Nodo sobre la línea */
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 6px);
    top: 0.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--void);
    border: 2px solid var(--nebula);
  }

  .periodo {
    color: var(--star);
    font-size: var(--fs-small);
    margin-bottom: 0.25rem;
  }

  h3 {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
  }

  .capas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.625rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--nebula);
  }
</style>
