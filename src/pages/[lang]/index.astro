---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Servicios from '../../components/Servicios.astro';
import Como from '../../components/Como.astro';
import Contacto from '../../components/Contacto.astro';
import { useTranslations } from '../../i18n';
import { locales } from '../../site';
import type { Locale } from '../../site';

/** Una página por idioma, con el mismo código: lo que cambia es el contenido. */
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const altLang = locales.find((code) => code !== lang);
const t = useTranslations(lang);

/** Secciones presentes en esta página, en orden. Alimentan la navegación,
 *  así nunca hay anclas muertas. */
const sections = ['servicios', 'como', 'contacto'] as const;
---

<Base lang={lang} altLang={altLang} sections={[...sections]}>
  <Hero lang={lang} />

  <section id="servicios" class="servicios section" aria-labelledby="servicios-titulo">
    <div class="wrap stack">
      <h2 id="servicios-titulo">{t.servicios.title}</h2>
      <p class="lede">{t.servicios.lede}</p>
      <Servicios lang={lang} />
    </div>
  </section>

  <section id="como" class="section" aria-labelledby="como-titulo">
    <div class="wrap stack">
      <h2 id="como-titulo">{t.como.title}</h2>
      <Como lang={lang} />
    </div>
  </section>

  <section id="contacto" class="contacto wrap" aria-labelledby="contacto-titulo">
    <Contacto lang={lang} />
  </section>
</Base>

<style>
  .servicios {
    background: var(--white);
  }

  .stack {
    gap: 1.5rem;
  }

  h2 {
    font-size: var(--fs-h2);
  }

  .lede {
    margin-bottom: 1.5rem;
  }

  .contacto {
    padding-bottom: clamp(4rem, 3rem + 4vw, 6rem);
  }
</style>
