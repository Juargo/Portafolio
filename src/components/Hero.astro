---
import { useTranslations, mailtoHref } from '../i18n';
import type { Locale } from '../site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="wrap stack">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.title}</h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="actions">
      <a class="btn" href={mailtoHref(lang)}>{t.hero.cta}</a>
      <a class="btn-quiet" href="#ahora">{t.hero.ctaSecondary} →</a>
    </div>
  </div>
</section>

<style>
  /* Campo de estrellas: posiciones fijas, apartadas de la columna de texto. */
  .hero {
    position: relative;
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 88% 16%, var(--lavender) 50%, transparent 51%),
      radial-gradient(1px 1px at 79% 34%, var(--stardust) 50%, transparent 51%),
      radial-gradient(2px 2px at 93% 52%, var(--star) 50%, transparent 51%),
      radial-gradient(1px 1px at 84% 72%, var(--stardust) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 96% 86%, var(--nebula) 50%, transparent 51%);
    background-repeat: no-repeat;
  }

  /* En pantallas angostas el texto ocupa todo el ancho: sin estrellas detrás. */
  @media (max-width: 48rem) {
    .hero::before {
      display: none;
    }
  }

  .stack {
    gap: 1.5rem;
    padding-block: 4.5rem 5.5rem;
  }

  h1 {
    font-size: var(--fs-display);
    max-width: 48ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
</style>
