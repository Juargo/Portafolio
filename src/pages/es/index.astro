---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Servicio from '../../components/Servicio.astro';
import Timeline from '../../components/Timeline.astro';
import Skills from '../../components/Skills.astro';
import { useTranslations, byLang } from '../../i18n';
import { getMilestoneProgress } from '../../lib/progress';
import { GH_PROGRESS_TOKEN } from 'astro:env/server';

const lang = 'es' as const;
const t = useTranslations(lang);

/** Secciones presentes en esta página, en orden. Numeran el encabezado y
 *  alimentan la navegación, así nunca hay anclas muertas ni saltos de número. */
const sections = ['ahora', 'servicio', 'trayectoria', 'skills'] as const;
const n = (id: (typeof sections)[number]) => sections.indexOf(id) + 1;

const proyectos = await Promise.all(
  byLang(await getCollection('proyectos'), lang)
    .sort((a, b) => a.data.orden - b.data.orden)
    .map(async (proyecto) => ({
      ...proyecto.data,
      avance: await getMilestoneProgress(proyecto.data.repo, proyecto.data.milestone, {
        token: GH_PROGRESS_TOKEN,
      }),
    })),
);

const skills = byLang(await getCollection('skills'), lang).map((entry) => entry.data);

const etapas = byLang(await getCollection('trayectoria'), lang)
  .sort((a, b) => b.data.desde - a.data.desde)
  .map((entry) => entry.data);
---

<Base lang={lang} sections={[...sections]}>
  <Hero lang={lang} />

  <section id="ahora" class="wrap stack section">
    <SectionHeading
      n={n('ahora')}
      eyebrow={t.ahora.eyebrow}
      title={t.ahora.title}
      lede={t.ahora.lede}
    />
    <div class="cards">
      {proyectos.map((proyecto) => (
        <ProjectCard lang={lang} {...proyecto} />
      ))}
    </div>
  </section>

  <section id="servicio" class="wrap stack section">
    <SectionHeading
      n={n('servicio')}
      eyebrow={t.servicio.eyebrow}
      title={t.servicio.title}
      lede={t.servicio.lede}
    />
    <Servicio lang={lang} />
  </section>

  <section id="trayectoria" class="wrap stack section">
    <SectionHeading
      n={n('trayectoria')}
      eyebrow={t.trayectoria.eyebrow}
      title={t.trayectoria.title}
      lede={t.trayectoria.lede}
    />
    <Timeline etapas={etapas} />
  </section>

  <section id="skills" class="wrap stack section">
    <SectionHeading n={n('skills')} eyebrow={t.skills.eyebrow} title={t.skills.title} />
    <Skills lang={lang} skills={skills} />
  </section>
</Base>

<style>
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
</style>
