---
import { useTranslations, whatsappHref } from '../i18n';
import { site } from '../site';
import type { Locale } from '../site';

type SectionId = 'servicios' | 'como' | 'contacto';

interface Props {
  lang: Locale;
  altLang?: Locale;
  /** Solo las secciones presentes en la página: evita anclas muertas. */
  sections?: SectionId[];
}

const { lang, altLang, sections = [] } = Astro.props;
const t = useTranslations(lang);

// "Contacto" no va en el menú: el botón "Escríbeme" cumple ese papel.
const links = sections
  .filter((id) => id !== 'contacto')
  .map((id) => ({ href: `#${id}`, label: t.nav[id] }));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={`/${lang}/`}>
      <span class="logo" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"></path></svg>
      </span>
      {site.brand}
    </a>
    <nav aria-label={t.nav.sectionsLabel}>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        {altLang && (
          <li>
            <a class="lang" href={`/${altLang}/`} lang={altLang} hreflang={altLang}>
              {altLang.toUpperCase()}
            </a>
          </li>
        )}
        <li><a class="cta" href={whatsappHref(lang)}>{t.nav.cta}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--teal);
    color: var(--white);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 30rem) {
    nav ul {
      column-gap: 0.875rem;
    }
  }

  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    text-decoration: underline;
  }

  .lang {
    border: 2px solid var(--line);
    border-radius: 8px;
    padding-inline: 0.625rem;
    color: var(--ink-soft);
  }

  .cta {
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: var(--teal);
    color: var(--white);
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--teal-dark);
    color: var(--white);
    text-decoration: none;
  }
</style>
