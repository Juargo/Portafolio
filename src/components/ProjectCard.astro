---
import { useTranslations } from '../i18n';
import { hreflang } from '../site';
import type { Locale } from '../site';
import type { MilestoneProgress } from '../lib/progress';

interface Props {
  lang: Locale;
  titulo: string;
  estado: 'idea' | 'diseno' | 'desarrollo' | 'publicado';
  nota?: string;
  descripcion: string;
  stack: string[];
  enlace?: string;
  repo?: string;
  /** Avance de cada milestone del repositorio; sin él no hay barras (ADR 0005). */
  milestones?: MilestoneProgress[] | null;
}

const { lang, titulo, estado, nota, descripcion, stack, enlace, repo, milestones } = Astro.props;
const t = useTranslations(lang);
const estadoLabel = nota ? `${t.estado[estado]} · ${nota}` : t.estado[estado];

// La fecha límite viene en UTC; se muestra el día tal como se fijó en GitHub.
const thisYear = new Date().getUTCFullYear();
const fecha = (iso: string) => {
  const date = new Date(iso);
  return new Intl.DateTimeFormat(hreflang[lang], {
    day: 'numeric',
    month: 'short',
    year: date.getUTCFullYear() === thisYear ? undefined : 'numeric',
    timeZone: 'UTC',
  }).format(date);
};

const barras = (milestones ?? []).map((m) => ({
  ...m,
  nota:
    m.state === 'closed'
      ? t.proyecto.milestoneCerrado
      : m.dueOn
        ? t.proyecto.milestoneVence.replace('{fecha}', fecha(m.dueOn))
        : '',
  detalle: t.proyecto.avanceDetalle
    .replace('{cerrados}', String(m.closed))
    .replace('{total}', String(m.total)),
}));
---

<article class="card stack">
  <p class="estado" data-estado={estado}>
    <span class="dot" aria-hidden="true"></span>{estadoLabel}
  </p>
  <h3>{titulo}</h3>
  <p class="muted desc">{descripcion}</p>
  {barras.length > 0 && (
    <ul class="avance" aria-label={t.proyecto.avance}>
      {barras.map((m) => (
        <li>
          <p class="avance-head">
            <span class="avance-nombre">
              {m.title}
              {m.nota && <span class="muted"> · {m.nota}</span>}
            </span>
            <span class="avance-pct">{m.percent} %</span>
          </p>
          <div
            class="track"
            role="progressbar"
            aria-label={t.proyecto.avanceLabel.replace('{titulo}', titulo).replace('{milestone}', m.title)}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={m.percent}
            aria-valuetext={`${m.percent} %, ${m.detalle}`}
          >
            <div class="fill" style={`width: ${m.percent}%`}></div>
          </div>
        </li>
      ))}
    </ul>
  )}
  {stack.length > 0 && (
    <ul class="tags stack-list" aria-label={t.proyecto.stackLabel}>
      {stack.map((item) => <li class="tech">{item}</li>)}
    </ul>
  )}
  {(enlace || repo) && (
    <p class="links">
      {enlace && <a href={enlace}>{t.proyecto.ver}</a>}
      {repo && <a href={repo}>{t.proyecto.repo}</a>}
    </p>
  )}
</article>

<style>
  .card {
    flex: 1 1 17.5rem;
    min-width: 0;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--nebula-dark);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .estado {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--star);
  }

  .estado[data-estado='idea'] {
    color: var(--stardust);
  }

  .estado[data-estado='publicado'] {
    color: var(--aurora);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  h3 {
    font-size: var(--fs-h3);
  }

  .desc {
    font-size: 0.9375rem;
  }

  .avance {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }

  .avance li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .avance-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--lavender);
  }

  .avance-nombre {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .avance-pct {
    flex: none;
    font-weight: 700;
  }

  .track {
    height: 0.5rem;
    background: var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .fill {
    height: 100%;
    background: var(--aurora);
    border-radius: inherit;
  }

  .stack-list {
    margin-top: auto;
  }

  .tech {
    font-size: 0.8125rem;
    color: var(--nebula);
  }

  .tech:not(:last-child)::after {
    content: ' ·';
    color: var(--border);
  }

  .links {
    display: flex;
    gap: 1.25rem;
    font-size: var(--fs-small);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
  }
</style>
