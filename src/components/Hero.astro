---
import { Image } from 'astro:assets';
import foto from '../assets/jorge.jpg';
import { useTranslations } from '../i18n';
import type { Locale } from '../site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero wrap">
  <div class="texto stack">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.title}</h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="actions">
      <a class="btn" href="#contacto">{t.hero.cta}</a>
      <a class="btn-outline" href="#servicios">{t.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="panel">
    <div class="saludo">
      <Image
        class="foto"
        src={foto}
        alt={t.hero.fotoAlt}
        width={240}
        height={240}
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <p class="saludo-titulo">{t.hero.saludo}</p>
        <p class="muted">{t.hero.saludoTexto}</p>
      </div>
    </div>
    <div class="dato">
      <p class="dato-valor">{t.hero.experiencia}</p>
      <p class="muted">{t.hero.experienciaTexto}</p>
    </div>
    <div class="dato">
      <p class="dato-valor">{t.hero.domicilio}</p>
      <p class="muted">{t.hero.domicilioTexto}</p>
    </div>
    <div class="dato ancho">
      <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
      <p>{t.hero.diagnostico}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3rem;
    padding-block: 3rem 5rem;
  }

  .texto {
    flex: 1 1 30rem;
    min-width: 0;
    gap: 1.5rem;
  }

  h1 {
    font-size: var(--fs-display);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .panel {
    flex: 1 1 22rem;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1rem;
    padding: 2rem;
    border-radius: 28px;
    background: var(--mint);
  }

  @media (max-width: 30rem) {
    .panel {
      padding: 1.25rem;
    }
  }

  .saludo {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .saludo > div {
    flex: 1 1 11rem;
    min-width: 0;
  }

  .foto {
    width: 120px;
    height: 120px;
    border-radius: 999px;
    border: 4px solid var(--white);
    object-fit: cover;
    flex: 0 0 auto;
  }

  .saludo-titulo {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.625rem;
  }

  .saludo .muted,
  .dato .muted {
    font-size: var(--fs-small);
  }

  .dato {
    padding: 1.5rem;
    border-radius: 20px;
    background: var(--white);
  }

  .dato-valor {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--teal);
  }

  .ancho {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--teal);
  }

  .ancho p {
    color: var(--ink);
    font-size: 1.0625rem;
  }

  .ancho svg {
    flex: 0 0 auto;
  }
</style>
