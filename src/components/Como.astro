---
import { useTranslations } from '../i18n';
import type { Locale } from '../site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<ol class="pasos">
  {t.como.pasos.map((paso, i) => (
    <li>
      <span class="numero" aria-hidden="true">{i + 1}</span>
      <h3>{paso.titulo}</h3>
      <p class="muted">{paso.texto}</p>
    </li>
  ))}
</ol>

<style>
  .pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .numero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--teal);
    color: var(--white);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.375rem;
  }

  h3 {
    font-size: 1.375rem;
  }
</style>
